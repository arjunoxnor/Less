{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "less-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "less-prod",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3100",
        "--directory",
        "out"
      ],
      "port": 3100
    },
    {
      "name": "less-api-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "wrangler@4",
        "pages",
        "dev",
        "out",
        "--port",
        "8788"
      ],
      "port": 8788
    }
  ]
}
