# LESS — environment variables
#
# v1 (the editor) needs NONE of these — it runs fully local-first.
# These come into play in Phase 2 (save / auth / cloud sync with Supabase).
#
# Copy this file to `.env.local` and fill in the values from the Supabase
# dashboard (Project Settings -> API). The URL can be derived from the project
# ref in secrets/supabase.env as https://<PROJECT_REF>.supabase.co.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
